<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The Needs-you sweep (#16): every 30 minutes, raise the items nothing else raises (unknown size for a company in
  play, missing email domain for a company being emailed, unclear sponsorship wording), and clear the items whose
  company, board or posting went away or fell out of the plan. It reads stored data only and is safe to run twice.
  Each full run writes one heartbeat event, so health can show when it last ran. One log line per kind changed.

  StartInterval misses ticks while the Mac sleeps, and that is safe: the next tick reads the same stored data.

  It follows the deploy tool's one convention (#17, outreach/deploy/jobs.py): WorkingDirectory is the live checkout,
  the program is the checkout's venv python run as a module, and both streams go to the log. Placeholders, filled by
  the deploy tool: {{LIVE_CHECKOUT}} is the live checkout, {{LOG_PATH}} the log file. Nothing else is filled; the
  store is the default.

  Not installed by the repo, and never loaded from a worktree. The deploy tool (#17) installs it as a required job.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.devanshu.outreach-needs-you</string>
  <key>WorkingDirectory</key>
  <string>{{LIVE_CHECKOUT}}</string>
  <key>ProgramArguments</key>
  <array>
    <string>{{LIVE_CHECKOUT}}/.venv/bin/python</string>
    <string>-m</string>
    <string>outreach.review</string>
    <string>sweep</string>
  </array>
  <key>StartInterval</key>
  <integer>1800</integer>
  <key>StandardOutPath</key>
  <string>{{LOG_PATH}}</string>
  <key>StandardErrorPath</key>
  <string>{{LOG_PATH}}</string>
</dict>
</plist>
